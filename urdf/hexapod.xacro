<?xml version="1.0" ?>
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_height" value="0.05" />
  <xacro:property name="lidar_radius" value="0.025" />
  <xacro:property name="lidar_range" value="6" />
  <xacro:property name="lidar_mass" value="0.1" />

  <xacro:include filename="$(find hexapod)/urdf/materials.xacro" />
  <xacro:include filename="$(find hexapod)/urdf/hexapod.trans" />
  <xacro:include filename="$(find hexapod)/urdf/hexapod.gazebo" />

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m * (3 * r * r + h * h) / 12}" ixy="0" ixz="0"
      iyy="${m * (3 * r * r + h * h) / 12}" iyz="0"
      izz="${m * r * r / 2}"
    />
  </xacro:macro>

  <xacro:macro name="leg_grip_surface_props">
    <surface>
      <friction>
        <ode>
          <mu>100000</mu>
          <mu2>100000</mu2>
        </ode>
      </friction>
      <contact>
        <ode>
          <soft_cfm>100.0</soft_cfm>
          <soft_erp>10.0</soft_erp>
          <min_depth>0.003</min_depth>
        </ode>
      </contact>
    </surface>
  </xacro:macro>

  <xacro:macro name="leg_grip_joint_props">
    <axis>
      <xyz>1.0 0.0 0.0</xyz>
      <dynamics>
        <friction>100000</friction>
        <damping>0.5</damping>
      </dynamics>
    </axis>
    <physics>
      <ode>
        <implicit_spring_damper>1</implicit_spring_damper>
      </ode>
    </physics>
  </xacro:macro>

  <link name="dummy">
  </link>

  <link name="base_link">
    <inertial>
      <origin xyz="2.4070960763754144e-11 6.3476485072098135e-12 0.1709901766523239" rpy="0 0 0"/>
      <mass value="1.5574752213508936"/>
      <inertia ixx="0.042556" iyy="0.014288" izz="0.051181" ixy="0.0" iyz="0.0" ixz="-0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hexapod/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hexapod/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="leg_6dof_v2_1">
    <inertial>
      <origin xyz="0.0050000000000001155 -0.03235166076884674 -0.07070254923546676" rpy="0 0 0"/>
      <mass value="0.02386470398218519"/>
      <inertia ixx="0.000127" iyy="0.000102" izz="2.5e-05" ixy="-0.0" iyz="-1.4e-05" ixz="-0.0"/>

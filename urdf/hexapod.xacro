  <link name="link_lidar">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <inertial>
      <mass value="${lidar_mass}"/>
      <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="${lidar_radius}"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="${lidar_radius}"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint_lidar" type="fixed">
    <origin rpy="0 0 1.5708" xyz="0 0 0.262" />

    <parent link="base_link"/>
    <child link="link_lidar"/>
    <limit effort="1000" velocity="1"/>
        <axis rpy="0 0 0" xyz="0 0 1"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <joint name="dummy_joint" type="fixed">
    <parent link="dummy"/>
    <child link="base_link"/>
  </joint>

  <joint name="right_hind_leg_joint" type="continuous">

  <type>transmission_interface/SimpleTransmission</type>
  <joint name="left_hind_leg_joint">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
  </joint>
  <actuator name="left_hind_leg_joint_actr">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<transmission name="left_mid_leg_joint_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="left_mid_leg_joint">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
  </joint>
  <actuator name="left_mid_leg_joint_actr">
    <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

<transmission name="left_front_leg_joint_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="left_front_leg_joint">

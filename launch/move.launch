<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <!-- Arguments -->
  <arg name="cmd_vel_topic" default="/move_base/cmd_vel" />
  <arg name="odom_topic" default="odom" />

  <!-- move_base -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="log">
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />
    <param name="recovery_behavior_enabled" value="false" />
    <param name="max_planning_retries" value="-1.0" />
    <param name="oscillation_timeout" value="0.0" />
    <rosparam file="$(find hexapod)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find hexapod)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find hexapod)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find hexapod)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find hexapod)/param/move_base_params.yaml" command="load" />
    <rosparam file="$(find hexapod)/param/dwa_local_planner_params.yaml" command="load" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <param name="DWAPlannerROS/min_vel_x" value="0.0" />
    <param name="DWAPlannerROS/yaw_goal_tolerance" value="0.2" />
    <param name="DWAPlannerROS/xy_goal_tolerance" value="0.25" />
  </node>

  <node name="cmd_vel_publisher" pkg="hexapod" type="cmd_vel_publisher.py" output="screen" />
</launch>
